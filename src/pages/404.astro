---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 - Page Not Found | Michael Jenkins">
  <section class="flex min-h-screen items-center justify-center px-4">
    <div class="text-center">
      <h1 class="mb-4 text-6xl font-bold">404</h1>
      <p class="mb-6 text-xl opacity-60">Page not found</p>
      <a href="/" class="btn preset-filled-primary-500 btn-base">Go Home</a>
    </div>
  </section>
</Layout>
