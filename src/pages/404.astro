---
import Layout from "#layouts/Layout.astro";
---

<Layout title="404 - Page Not Found">
  <main id="main">
    <section class="flex min-h-screen items-center justify-center px-4">
      <div class="text-center">
        <h1 class="mb-4 h1 text-6xl font-bold">404</h1>
        <p class="mb-6 text-xl opacity-60">Page not found</p>
        <a href="/" class="btn preset-filled-brand">
          Go Home
        </a>
      </div>
    </section>
  </main>
</Layout>
