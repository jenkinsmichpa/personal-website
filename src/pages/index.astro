---
import { Image, getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import NavBar from '@components/NavBar.svelte';
import AboutSection from '@components/AboutSection.svelte';
import PortfolioSection from '@components/PortfolioSection.svelte';
import ContactSection from '@components/ContactSection.svelte';
import portrait from '@assets/images/michaelJenkinsPortrait.jpg';
import drinkingTiger from '@assets/images/drinkingTiger.jpg';
import hibiscus from '@assets/images/hibiscus.jpg';
import seaCliffs from '@assets/images/seaCliffs.jpg';
import lighthouse from '@assets/images/lighthouse.jpg';
import mountainRange from '@assets/images/mountainRange.jpg';
import impressionistLake from '@assets/images/impressionistLake.jpg';
import scarletTanager from '@assets/images/scarletTanager.jpg';
import rainbowTanager from '@assets/images/rainbowTanager.jpg';
import river from '@assets/images/river.jpg';
import turtleBearSkull from '@assets/images/turtleBearSkull.jpg';
import elderlyCouple from '@assets/images/elderlyCouple.jpg';
import stinkingBenjamin from '@assets/images/stinkingBenjamin.jpg';

const portfolioPages = [
  [
    { file: 'drinkingTiger', alt: 'Drinking Tiger Painting', img: drinkingTiger },
    { file: 'hibiscus', alt: 'Hibiscus Painting', img: hibiscus },
    { file: 'seaCliffs', alt: 'Sea Cliffs Painting', img: seaCliffs },
    { file: 'lighthouse', alt: 'Lighthouse Painting', img: lighthouse },
    { file: 'mountainRange', alt: 'Mountain Range Painting', img: mountainRange },
    { file: 'impressionistLake', alt: 'Impressionist Lake Painting', img: impressionistLake }
  ],
  [
    { file: 'scarletTanager', alt: 'Scarlet Tanager Painting', img: scarletTanager },
    { file: 'rainbowTanager', alt: 'Rainbow Tanager Painting', img: rainbowTanager },
    { file: 'river', alt: 'River Painting', img: river }
  ],
  [
    { file: 'turtleBearSkull', alt: 'Turtle Bear Skull Painting', img: turtleBearSkull },
    { file: 'elderlyCouple', alt: 'Elderly Couple Pastel Painting', img: elderlyCouple },
    { file: 'stinkingBenjamin', alt: 'Stinking Benjamin Painting', img: stinkingBenjamin }
  ]
];

const optimizedPortrait = await getImage({ src: portrait, width: 600, format: 'webp', quality: 'high' });

const portfolioData = await Promise.all(
  portfolioPages.map(async (page) =>
    Promise.all(
      page.map(async (item) => ({
        fullSrc: item.img.src,
        alt: item.alt,
        thumb: await getImage({ src: item.img, width: 400, format: 'webp', quality: 'mid' })
      }))
    )
  )
);
---

<Layout>
  <NavBar client:load />

  <section
    class="home-section parallax-section border-surface-200-800 flex items-center justify-center border-b"
    id="home"
  >
    <div class="relative z-10 px-4 text-center">
      <Image
        src={portrait}
        alt="Michael Jenkins Portrait"
        class="mx-auto mb-4 size-52 rounded-full border-[3px] border-white object-cover shadow-lg"
        width={208}
        height={208}
        loading="eager"
      />
      <h1 class="mb-2 text-3xl leading-tight font-bold text-white sm:text-4xl md:text-5xl">
        Hello, I'm Michael Jenkins
      </h1>
      <p class="text-xl text-white/80 sm:text-2xl md:text-3xl">InfoSec Graduate Student</p>
    </div>
  </section>

  <AboutSection portraitSrc={optimizedPortrait.src} client:idle />

  <div class="parallax-section spacer-section">
    <div class="spacer-blur"></div>
  </div>

  <PortfolioSection data={portfolioData} client:visible />

  <div class="parallax-section spacer-section">
    <div class="spacer-blur"></div>
  </div>

  <ContactSection client:idle />

  <div class="parallax-section spacer-section">
    <div class="spacer-blur"></div>
  </div>

  <footer class="border-surface-200-800 border-t py-8">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
        <p class="text-sm opacity-60">
          Project code hosted on <a href="https://github.com/jenkinsmichpa/personal-website" class="anchor font-medium"
            ><u>GitHub</u></a
          >
        </p>
        <p class="text-sm opacity-60">&copy; {new Date().getFullYear()} Michael Jenkins</p>
      </div>
    </div>
  </footer>
</Layout>
