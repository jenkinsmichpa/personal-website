---
import portrait from "@assets/images/michaelJenkinsPortrait.jpg";
import AboutSection from "@components/AboutSection.svelte";
import ContactSection from "@components/ContactSection.svelte";
import NavBar from "@components/NavBar.svelte";
import PortfolioSection from "@components/PortfolioSection.svelte";
import Spacer from "@components/Spacer.astro";
import Layout from "@layouts/Layout.astro";
import type { AboutPortrait } from "@lib/about";
import { buildObfuscatedEmail } from "@lib/contact.server";
import { portfolioPages } from "@lib/portfolio";
import { getImage, Image } from "astro:assets";

const optimizedPortrait = await getImage({ src: portrait, width: 600, format: "webp", quality: 80 });
const portraitData: AboutPortrait = {
  src: optimizedPortrait.src,
  width: Number(optimizedPortrait.attributes.width),
  height: Number(optimizedPortrait.attributes.height)
};
// Built server-side so the plain address never gets in the client bundle.
const obfuscatedEmail = buildObfuscatedEmail("me@jenkinsmichpa.com");

const portfolioData = await Promise.all(
  portfolioPages.map((page) =>
    Promise.all(
      page.map(async (item) => {
        const thumb = await getImage({ src: item.img, width: 400, format: "webp", quality: 60 });
        return {
          fullSrc: item.img.src,
          fullWidth: item.img.width,
          fullHeight: item.img.height,
          alt: item.alt,
          thumbSrc: thumb.src,
          thumbWidth: Number(thumb.attributes.width),
          thumbHeight: Number(thumb.attributes.height)
        };
      })
    )
  )
);
---

<Layout preloadHomeBg>
  <NavBar client:load />

  <section
    class="home-section parallax-section flex items-center justify-center border-b border-surface-200-800"
    id="home"
  >
    <div class="relative z-10 px-4 text-center">
      <Image
        src={portrait}
        alt="Michael Jenkins Portrait"
        class="mx-auto mb-4 size-52 rounded-full border-[3px] border-white object-cover shadow-lg"
        width={208}
        height={208}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <h1 class="mb-2 text-3xl leading-tight font-bold text-white sm:text-4xl md:text-5xl">
        Hello, I'm Michael Jenkins
      </h1>
      <p class="text-xl text-white/80 sm:text-2xl md:text-3xl">InfoSec Graduate Student</p>
    </div>
  </section>

  <AboutSection portrait={portraitData} client:idle />

  <Spacer />

  <PortfolioSection data={portfolioData} client:visible />

  <Spacer />

  <ContactSection obfuscated={obfuscatedEmail} client:visible />

  <Spacer />

  <footer
    class="border-t border-surface-200-800 py-8 max-md:pb-[calc(var(--bottom-nav-h)+env(safe-area-inset-bottom,0))]"
  >
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
        <p class="text-sm opacity-60">
          Project code hosted on <a
            href="https://github.com/jenkinsmichpa/personal-website"
            class="anchor font-medium underline">GitHub</a
          >
        </p>
        <p class="text-sm opacity-60">&copy; {new Date().getFullYear()} Michael Jenkins</p>
      </div>
    </div>
  </footer>
</Layout>
