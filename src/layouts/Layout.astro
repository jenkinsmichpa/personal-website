---
import "../styles/global.css";

// import { createHash } from "node:crypto";
import portrait from "@assets/images/michaelJenkinsPortrait.jpg";
import spacerBg from "@assets/images/poisonIvyMultiplied.jpg";
import homeBg from "@assets/images/triliumPoisonIvyMultiplied.jpg";
import { getImage } from "astro:assets";
import { SEO } from "astro-seo";
const optimizedHomeBg = await getImage({ src: homeBg, format: "webp", width: 2560 });
const optimizedSpacerBg = await getImage({ src: spacerBg, format: "webp", width: 2560 });
const {
  title,
  description = "Michael Jenkins is a graduate student at Purdue University, pursuing a Masters degree in Computer and Information Technology with a focus on Cybersecurity."
} = Astro.props;
const image = new URL(portrait.src, Astro.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Michael Jenkins",
  url: "https://jenkinsmichpa.com",
  image,
  jobTitle: "Cyber Security Consulting Senior Staff",
  alumniOf: { "@type": "EducationalOrganization", name: "Purdue University" },
  sameAs: [
    "https://www.linkedin.com/in/jenkinsmichpa",
    "https://github.com/jenkinsmichpa",
    "https://infosec.exchange/@jenkinsmichpa",
    "https://bsky.app/profile/jenkinsmichpa.bsky.social",
    "https://x.com/jenkinsmichpa",
    "https://www.instagram.com/jenkinsmichpa/"
  ]
};
const bgCss = `:root{--bg-home:url(${optimizedHomeBg.src});--bg-spacer:url(${optimizedSpacerBg.src})}`;
// const bgHash = "sha256-" + createHash("sha256").update(bgCss).digest("base64");
const ldJson = JSON.stringify(structuredData);
// const ldHash = "sha256-" + createHash("sha256").update(ldJson).digest("base64");
// Astro.csp?.insertStyleHash(bgHash as `sha256-${string}`);
// Astro.csp?.insertScriptHash(ldHash as `sha256-${string}`);
---

<!doctype html>
<html lang="en" data-theme="fennec">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      titleTemplate="%s | Michael Jenkins"
      titleDefault="Michael Jenkins"
      description={description}
      removeTrailingSlashForRoot
      openGraph={{
        basic: {
          title: title ?? "Michael Jenkins",
          type: "website",
          image
        },
        optional: {
          description,
          siteName: "Michael Jenkins"
        },
        image: {
          width: portrait.width,
          height: portrait.height,
          alt: "Michael Jenkins Portrait"
        }
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@jenkinsmichpa",
        site: "@jenkinsmichpa"
      }}
      extend={{
        meta: [
          { name: "author", content: "Michael Jenkins" },
          {
            name: "keywords",
            content: "Michael Jenkins, Cybersecurity, Purdue, Portfolio, Resume, Penetration Testing, InfoSec"
          }
        ]
      }}
    />
    <style set:html={bgCss}></style>
    <script is:inline src="/theme.js"></script>
    <script is:inline type="application/ld+json" set:html={ldJson} />
    <link rel="preload" href={optimizedHomeBg.src} as="image" type="image/webp" />
  </head>
  <body class="bg-surface-50-950 text-surface-900-100">
    <main><slot /></main>
  </body>
</html>
