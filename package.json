{
  "name": "personal-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#lib/*": "./src/lib/*",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint .",
    "lint:fix": "bun run format; fmt_status=$?; bun run lint:oxlint:fix; oxlint_status=$?; bun run lint:eslint:fix; eslint_status=$?; exit $((fmt_status || oxlint_status || eslint_status))",
    "lint:eslint:fix": "eslint . --fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "validate": "bun run format:check && bun run lint && bun run typecheck",
    "format": "bun run format:oxfmt",
    "format:oxfmt": "oxfmt",
    "format:check": "bun run format:check:oxfmt",
    "format:check:oxfmt": "oxfmt --check",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist .astro node_modules",
    "skills:sync": "skills experimental_sync -y -a opencode",
    "skills:install": "skills experimental_install -y -a opencode"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/svelte": "9.1.6",
    "@lucide/svelte": "1.81.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "astro-favicons": "3.1.8",
    "astro-seo": "1.2.0",
    "mode-watcher": "1.1.0",
    "svelte": "5.59.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@iconify-json/fa6-brands": "1.2.6",
    "@nkzw/oxlint-config": "4.1.0",
    "@skeletonlabs/skeleton": "5.0.6",
    "@skeletonlabs/skeleton-svelte": "5.0.6",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.2",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "skills": "1.9.0",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.12.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "unplugin-icons": "24.0.0",
    "wrangler": "4.168.0"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "skills": [
    {
      "source": "sveltejs/ai-tools/tools/skills",
      "skills": [
        "svelte-core-bestpractices",
        "svelte-code-writer"
      ]
    }
  ]
}
