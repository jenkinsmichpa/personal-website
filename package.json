{
  "name": "personal-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint .",
    "lint:fix": "bun run format; fmt_status=$?; bun run lint:oxlint:fix; oxlint_status=$?; bun run lint:eslint:fix; eslint_status=$?; exit $((fmt_status || oxlint_status || eslint_status))",
    "lint:eslint:fix": "eslint . --fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "validate": "bun run format:check && bun run lint && bun run check",
    "format": "bun run format:oxfmt && bun run format:prettier",
    "format:oxfmt": "oxfmt",
    "format:prettier": "prettier --write \"src/**/*.astro\"",
    "format:check": "bun run format:check:oxfmt && bun run format:check:prettier",
    "format:check:oxfmt": "oxfmt --check",
    "format:check:prettier": "prettier --check \"src/**/*.astro\"",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist .astro node_modules"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.0.1",
    "@iconify-json/fa6-brands": "1.2.6",
    "@lucide/svelte": "1.44.0",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "astro-favicons": "3.1.6",
    "astro-seo": "1.2.0",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@oxlint/plugins": "1.82.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-icons": "23.0.1",
    "wrangler": "4.130.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
